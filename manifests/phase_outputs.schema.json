{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ML CP Phase Outputs Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["phase_id", "generated_at", "outputs"],
  "properties": {
    "phase_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "byte_size", "sha256", "status"],
        "properties": {
          "artifact_id": {"type": ["string", "null"]},
          "path": {"type": "string", "minLength": 1},
          "byte_size": {"type": "integer", "minimum": 0},
          "sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "status": {
            "enum": ["created", "updated", "preserved", "pending"]
          },
          "notes": {"type": "string"}
        }
      }
    }
  }
}
